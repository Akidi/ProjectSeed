# Shared container defaults
DATABASE_URL=db/db.sqlite
COMPOSE_PROJECT_NAME=projectseed
NODE_ENV={{NODE_ENV}}
APP_PROFILE={{APP_PROFILE}}
PNPM_HOME=/root/.local/share/pnpm

# Node/Svelte application
APP_IMAGE=node:20-bullseye
APP_DEV_PORT={{APP_DEV_PORT}}
APP_PROD_PORT={{APP_PROD_PORT}}
PUBLIC_ORIGIN={{PUBLIC_ORIGIN}}

# Postgres configuration
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=projectseed
POSTGRES_SUPERUSER=app_owner
POSTGRES_SUPERUSER_PASSWORD={{POSTGRES_SUPERUSER_PASSWORD}}
POSTGRES_APP_USER=app_runtime
POSTGRES_APP_PASSWORD={{POSTGRES_APP_PASSWORD}}
POSTGRES_API_USER=api_worker
POSTGRES_API_PASSWORD={{POSTGRES_API_PASSWORD}}
POSTGRES_READONLY_USER=app_reader
POSTGRES_READONLY_PASSWORD={{POSTGRES_READONLY_PASSWORD}}
POSTGRES_MIGRATIONS_USER=app_migrator
POSTGRES_MIGRATIONS_PASSWORD={{POSTGRES_MIGRATIONS_PASSWORD}}
POSTGRES_DATA_VOLUME=projectseed_postgres
POSTGRES_INIT_PATH=./infrastructure/postgres/{{ENVIRONMENT}}
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=scram-sha-256 --data-checksums

# Redis configuration
REDIS_IMAGE=redis:7.2-alpine
REDIS_ADMIN_USER=redis_admin
REDIS_ADMIN_PASSWORD={{REDIS_ADMIN_PASSWORD}}
REDIS_API_USER=redis_api
REDIS_API_PASSWORD={{REDIS_API_PASSWORD}}
REDIS_READONLY_USER=redis_readonly
REDIS_READONLY_PASSWORD={{REDIS_READONLY_PASSWORD}}
REDIS_DATA_VOLUME=projectseed_redis
REDIS_CONFIG_PATH=./infrastructure/redis/{{ENVIRONMENT}}

# Networking
SERVICES_NETWORK_NAME={{SERVICES_NETWORK_NAME}}
SERVICES_SUBNET={{SERVICES_SUBNET}}
SERVICES_GATEWAY={{SERVICES_GATEWAY}}
NETWORK_REDIS_IP={{NETWORK_REDIS_IP}}
